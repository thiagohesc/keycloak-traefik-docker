# Copie para .env e substitua os valores de exemplo antes de iniciar.
# Rede externa compartilhada com o Traefik (obrigatória)
TRAEFIK_NET=proxy

# Domínio público sem protocolo ou caminho (obrigatório)
KEYCLOAK_DOMAIN=auth.seudominio.com

# PostgreSQL externo: HOST e IP obrigatórios; porta fixa 5432.
# O Compose associa o hostname ao IP usando extra_hosts.
KEYCLOAK_DB_HOST=postgres.interno
KEYCLOAK_DB_IP=10.0.0.20
# Nome do banco e usuário têm padrão keycloak no Compose.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=COLOQUE_UMA_SENHA_FORTE

# Administrador de bootstrap (usuário padrão: admin).
# Alterar a senha aqui não redefine uma conta existente.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=COLOQUE_OUTRA_SENHA_FORTE
